[Unit]
Description=Cookie Router - Lightweight Web Cookie LLM Gateway
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cookie-router
ExecStart=/opt/cookie-router/cookie-router -config /opt/cookie-router/config.json
Restart=always
RestartSec=5
LimitNOFILE=65536
Environment=PORT=18899

[Install]
WantedBy=multi-user.target
